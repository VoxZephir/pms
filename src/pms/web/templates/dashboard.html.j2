{% extends "layout.html.j2" %}
{% block title %}{{ period.title }} · Relevé Swissquote{% endblock %}

{% block headerextra %}
{# Re-ingests inbox/, then restarts the server. Re-reading the ledger was never
   the hard part -- the store does that on an mtime change. Restarting is what
   picks up a backend that moved while this page was open. #}
<form method="post" action="{{ url_for('dashboard.refresh') }}" data-refresh class="d-inline">
  <button class="icon-btn" type="submit" id="refreshBtn"
          title="Réingérer inbox/ et redémarrer le serveur"
          aria-label="Recharger les données et redémarrer le serveur">⟳</button>
</form>
{% endblock %}

{% block body %}
<div class="wrap pt-5">
  {% include "partials/controls.html.j2" %}
</div>

<main class="wrap" id="main" tabindex="-1">
  {% include "partials/main.html.j2" %}
</main>

{# Slides up while a row is being dragged. Built from the window's own
   categories so a drop can never land on something the app does not know. #}
<div class="dropbar" id="dropbar" aria-hidden="true">
  <div class="wrap dropbar-inner">
    <span class="dropbar-title">Déposer dans</span>
    <div class="dropzones">
      {% for c in categories %}
      <button class="dropzone" data-drop-category="{{ c.category }}" type="button">
        <i class="dot" style="background:var(--s{{ c.slot }})"></i>{{ c.category }}
      </button>
      {% endfor %}
      {% for b in buckets.rows %}
      <button class="dropzone bucket" data-drop-bucket="{{ b.name }}" type="button">
        <i class="dot" style="background:{{ bucket_fill[b.name] }}"></i>{{ b.name }}
      </button>
      {% endfor %}
    </div>
  </div>
</div>

<footer class="wrap">
  Compte {{ window.iban }}.
  Les transferts de change sont des mouvements internes et n'entrent pas dans les dépenses ;
  les achats en EUR et USD sont convertis en CHF au taux réellement appliqué par la banque.
  La catégorisation est déduite du nom du bénéficiaire par règles.
</footer>
{% endblock %}
