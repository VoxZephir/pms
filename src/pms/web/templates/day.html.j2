{% extends "layout.html.j2" %}
{% block title %}{{ date|fr_date }} · Relevé Swissquote{% endblock %}

{% block headerextra %}
<a class="btn" href="{{ url_for('dashboard.dashboard', **{'from': date.isoformat(), 'to': date.isoformat(), 'grain': 'day'}) }}">Voir comme période</a>
{% endblock %}

{% block body %}
<main class="wrap pt-5" id="main" tabindex="-1">

  <nav class="crumbs" aria-label="Navigation">
    <a href="{{ url_for('dashboard.dashboard', preset='all') }}">Tout</a><em aria-hidden="true">›</em>
    <a href="{{ url_for('dashboard.dashboard', **{'from': date.replace(day=1).isoformat(), 'to': date.isoformat(), 'grain': 'day'}) }}">{{ date.strftime('%m.%Y') }}</a><em aria-hidden="true">›</em>
    <span class="here" aria-current="page">{{ date|fr_date }}</span>
  </nav>

  <div class="title-row">
    <h1>{{ date|fr_date }}</h1>
    <span class="sub">{{ rows|length }} mouvement{{ 's' if rows|length > 1 }}</span>
    <span class="spacer"></span>
    <span class="flex-row gap-2">
      {% if neighbours.prev < bounds[0] %}
      <span class="btn off" aria-disabled="true">← Veille</span>
      {% else %}
      <a class="btn" href="{{ url_for('dashboard.day', iso=neighbours.prev.isoformat()) }}">← Veille</a>
      {% endif %}
      {% if neighbours.next > bounds[1] %}
      <span class="btn off" aria-disabled="true">Lendemain →</span>
      {% else %}
      <a class="btn" href="{{ url_for('dashboard.day', iso=neighbours.next.isoformat()) }}">Lendemain →</a>
      {% endif %}
    </span>
  </div>

  <div class="kpis mb-5">
    <div class="card kpi">
      <div class="k-label">Dépensé</div>
      <div class="k-val">{{ spending|chf(2) }}<small>CHF</small></div>
    </div>
    <div class="card kpi">
      <div class="k-label">Encaissé</div>
      <div class="k-val {{ 'pos' if income }}">{{ income|chf(2) }}<small>CHF</small></div>
    </div>
    <div class="card kpi">
      <div class="k-label">Net</div>
      <div class="k-val {{ 'pos' if income - spending >= 0 else 'neg' }}">
        {{ '+' if income - spending >= 0 }}{{ (income - spending)|chf(2) }}<small>CHF</small>
      </div>
    </div>
    <div class="card kpi">
      <div class="k-label">Catégories touchées</div>
      <div class="k-val">{{ categories|length }}</div>
    </div>
  </div>

  <div class="card pad">
    <div class="chart-head">
      <h3>Mouvements de la journée</h3>
      <div class="hint">dans l'ordre du relevé</div>
    </div>
    <div class="tbl-wrap">
      <table class="data sortable-table">
        <thead>
          <tr>
            <th>Bénéficiaire</th><th>Type</th><th>Catégorie</th>
            <th class="r" data-type="num">Montant</th>
            <th class="r" data-type="num">En CHF</th>
            <th class="r" data-type="num">Solde après</th>
          </tr>
        </thead>
        <tbody>
          {% for t in rows %}
          <tr>
            <td>
              <div class="t-lab">{{ t.label }}</div>
              {% if t.location %}<div class="t-sub">{{ t.location }}</div>{% endif %}
            </td>
            <td class="t-sub">{{ t.kind }}</td>
            <td>
              <span class="chip">{{ t.category }}</span>
              {% if t.bucket %}<span class="chip">{{ t.bucket }}</span>{% endif %}
            </td>
            <td class="r num {{ 'pos' if t.amount >= 0 }}">{{ t.amount|chf(2) }} {{ t.currency }}</td>
            <td class="r num">{{ t.amount_chf|chf(2) }}</td>
            <td class="r num muted">{{ t.balance|chf(2) if t.balance is not none else '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% if categories %}
  <div class="card pad mt-5">
    <div class="chart-head"><h3>Répartition du jour</h3></div>
    <div class="bars">
      {% set top = categories[0].amount %}
      {% for c in categories %}
      <div class="bar">
        <span class="b-name"><span>{{ c.category }}</span></span>
        <span class="b-track"><i style="width:{{ (c.amount / top * 100)|round(2) }}%;background:var(--s0)"></i></span>
        <span class="b-amt num">{{ c.amount|chf(2) }} CHF</span>
        <span class="b-pct num">{{ c.count }}×</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</main>

<footer class="wrap">
  Le solde après mouvement est celui imprimé par la banque, dans l'ordre du relevé.
</footer>
{% endblock %}
