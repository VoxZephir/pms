{% extends "layout.html.j2" %}
{% block title %}Page introuvable · Relevé Swissquote{% endblock %}

{% block body %}
<main class="wrap pt-5 narrow-page" id="main" tabindex="-1">
  <div class="title-row">
    <h1>Page introuvable</h1>
    <span class="sub">cette adresse ne correspond à rien du relevé</span>
  </div>
  <div class="card pad">
