    <p class="flex-row gap-2 mt-3">
      <a class="btn" href="{{ page_url('dashboard.dashboard') }}">Tableau de bord</a>
      <a class="btn ghost" href="{{ page_url('dashboard.transactions') }}">Transactions</a>
    </p>
  </div>
</main>
