{# GOV.UK-style error summary: one link per failed field, then the next step.
   Rendered only when a POST failed validation -- the page is re-rendered in
   this state because the app keeps no session to flash a message in. The
   links jump to the fields; the red left border draws the eye. #}
{% if form_errors %}
<div class="error-summary" role="alert" tabindex="-1">
  <h4>Vérifiez les champs suivants</h4>
  <ul>
    {% for field, message in form_errors.items() %}
    <li><a href="#{{ field }}">{{ message }}</a></li>
    {% endfor %}
  </ul>
  <p>Corrigez les erreurs pour enregistrer.</p>
</div>
{% endif %}
