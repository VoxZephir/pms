{# The monthly-profile table, shared by /previsions and /analyse -- same
   numbers as the chart, one template, no second copy. #}
<div class="tbl-wrap mt-3">
  <table class="data">
    <thead>
      <tr>
        <th class="l">Mois</th>
        <th class="r">Médiane brute</th>
        <th class="l">Pics saisonniers retirés</th>
        <th class="r">Médiane hors saisonnier</th>
        <th class="r">Dispersion (Q3−Q1)</th>
        <th class="r">Années observées</th>
      </tr>
    </thead>
    <tbody>
      {% for p in monthly_profile %}
      <tr>
        <td>{{ p.label }}</td>
        <td class="r num">{{ p.raw_median|chf(0) }}</td>
        <td>
          {% for s in p.seasonal %}
          <span class="chip" title="Facturé {{ s.years|join(', ') }} — environ {{ s.amount|chf(0) }} CHF par an">~{{ s.amount|chf(0) }} · {{ s.category }}</span>
          {% else %}
          <span class="muted">—</span>
          {% endfor %}
        </td>
        <td class="r num">{{ p.stripped_median|chf(0) }}</td>
        <td class="r num" title="écart entre les quartiles des mois bruts — 0 quand une seule année est observée">{{ p.iqr|chf(0) }}</td>
        <td class="r num">{{ p.years|join(' · ') }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
