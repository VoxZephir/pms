{# The monthly-profile chart, shared by /previsions (where it explains the
   baseline) and /analyse (where it is the page's own chart). One geometry,
   one template -- like charts.py, no second copy of the coordinates. #}
<div class="chart-scroll">
  <svg class="chart" id="monthlyChart" viewBox="0 0 {{ monthly_analysis.width }} {{ monthly_analysis.height }}"
       role="img" aria-label="Dépense médiane par mois de l'année, pics saisonniers retirés comme dans la dépense mensuelle de base">
    {% for t in monthly_analysis.ticks %}
    <line class="gridline" x1="{{ monthly_analysis.pad_left }}" x2="{{ monthly_analysis.width - 12 }}"
          y1="{{ t.y }}" y2="{{ t.y }}"/>
    <text class="tick" x="{{ monthly_analysis.pad_left - 8 }}" y="{{ t.y + 4 }}" text-anchor="end">{{ t.value|chf(0) }}</text>
    {% endfor %}
    {% if monthly_analysis.floor_y %}
    <line class="axisline" x1="{{ monthly_analysis.pad_left }}" x2="{{ monthly_analysis.width - 12 }}"
          y1="{{ monthly_analysis.floor_y }}" y2="{{ monthly_analysis.floor_y }}"
          stroke-dasharray="2 3" opacity=".7"/>
    {% endif %}
    {% for c in monthly_analysis.columns %}
    <rect x="{{ c.x }}" y="{{ c.stripped_y }}" width="{{ c.w }}" height="{{ c.stripped_h }}"
          fill="var(--s0)" rx="1.5"/>
    {% if c.seasonal_h %}
    <rect x="{{ c.x }}" y="{{ c.seasonal_y }}" width="{{ c.w }}" height="{{ c.seasonal_h }}"
          fill="var(--s0)" opacity=".35" rx="1.5"/>
    {% endif %}
    <text class="tick" x="{{ c.band_x + c.band_w / 2 }}" y="{{ monthly_analysis.baseline + 18 }}"
          text-anchor="middle">{{ c.label }}</text>
    {% endfor %}
    <line class="crosshair" id="monthlyCross" y1="{{ monthly_analysis.pad_top }}" y2="{{ monthly_analysis.baseline }}"/>
    <line class="axisline" x1="{{ monthly_analysis.pad_left }}" x2="{{ monthly_analysis.width - 12 }}"
          y1="{{ monthly_analysis.baseline }}" y2="{{ monthly_analysis.baseline }}"/>
    <circle class="focus-dot" data-slot="0" r="4.5" fill="var(--s0)"
            stroke="var(--surface)" stroke-width="2"/>
    <circle class="focus-dot" data-slot="1" r="4.5" fill="var(--s1)"
            stroke="var(--surface)" stroke-width="2"/>
    <rect id="monthlyHit" x="{{ monthly_analysis.pad_left }}" y="{{ monthly_analysis.pad_top }}"
          width="{{ monthly_analysis.width - 12 - monthly_analysis.pad_left }}"
          height="{{ monthly_analysis.plot_h }}" fill="transparent"/>
  </svg>
</div>
