    <div class="bars">
      {% for r in charts.season.rows %}
      <div class="bar geo-grid" data-tip data-title="{{ r.label }}" data-rows='[["Moyenne","{{ r.average|chf(0) }} CHF",""],["Années observées","{{ r.years }}",""]]'>
        <span class="b-name"><span>{{ r.label }}</span></span>
        <span class="b-track"><i style="width:{{ r.pct|round(2) }}%;background:var(--s0)"></i></span>
        <span class="b-amt num">{{ r.average|chf(0) }} CHF</span>
