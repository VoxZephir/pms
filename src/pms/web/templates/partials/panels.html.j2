    </div>
    {# Twin of the hover-only month bars: the twelve months in calendar order. #}
    <details class="raw raw-table mt-4">
      <summary class="muted clickable f-md">Voir le détail en table</summary>
      <div class="tbl-wrap">
        <table class="data">
          <thead><tr>
            <th class="l">Mois</th>
            <th class="r">Dépense moyenne</th>
            <th class="r">Années observées</th>
          </tr></thead>
          <tbody>
            {% for r in charts.season.rows %}
            <tr>
              <td class="t-lab">{{ r.label }}</td>
              <td class="r num">{{ r.average|chf(2) }}</td>
