{% if panels.custodian %}
<section class="block card pad" id="p-custodian">
  <details class="fold">
  <summary>
    <span class="chev" aria-hidden="true">▸</span>
    <h3>Ce que le custodian a prélevé</h3>
    <span class="hint">{{ custodian.markup_chf|chf(2) }} CHF de marge sur {{ custodian.count }} conversions</span>
  </summary>

  <div class="kpis mb-5">
    <div class="card kpi flat">
      <div class="k-label">Marge de change</div>
      <div class="k-val">{{ custodian.markup_chf|chf(2) }}<small>CHF</small></div>
    </div>
    <div class="card kpi flat">
      <div class="k-label">Taux effectif</div>
      <div class="k-val">{{ custodian.effective_pct|round(2) }}<small>%</small></div>
    </div>
    <div class="card kpi flat">
      <div class="k-label">Volume converti</div>
      <div class="k-val">{{ custodian.volume_chf|chf(0) }}<small>CHF</small></div>
    </div>
    <div class="card kpi flat">
      <div class="k-label">Intérêts débiteurs</div>
      <div class="k-val">{{ custodian.interest_chf|chf(2) }}<small>CHF</small></div>
    </div>
    <div class="card kpi flat">
      <div class="k-label">Frais explicites</div>
      <div class="k-val">{{ custodian.explicit_fees_chf|chf(2) }}<small>CHF</small></div>
    </div>
  </div>

  <div class="callout mb-5">
    <b>La colonne « Frais et taxes » du relevé est vide.</b> Swissquote ne facture aucune
    commission explicite sur ce compte : le coût est l'écart entre le taux de change affiché
    et le montant réellement débité. Cet écart vaut {{ custodian.median_markup_pct|round(2) }} %
    en médiane et reste stable d'une opération à l'autre, ce qui en fait une marge tarifaire
    et non un aléa de marché.
  </div>

  {% if custodian.references %}
  <div class="callout mb-5">
    <b>La même chose ailleurs</b> — taux publiés vérifiés le
    {{ custodian.references_as_of }} (les grilles bougent) :
    {% for r in custodian.references %}
    <br><b>{{ r.name }}</b> ({{ r.rate }} %) : ≈ {{ r.would_cost|chf(0) }} CHF
    au lieu de {{ custodian.markup_chf|chf(0) }}
    {% if r.saved > 0 %}— {{ r.saved|chf(0) }} CHF de moins{% else %}— plus cher{% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {% if finpension and finpension.fees %}
  <div class="muted note mt-3">
    Aussi facturé hors Swissquote : frais administratifs du 3a finpension —
    {{ finpension.fees|chf(2) }} CHF depuis le {{ finpension.first }}
    (dépôts {{ finpension.deposits|chf(0) }} CHF, soit
    ~{{ (finpension.fees / finpension.deposits * 100)|round(1) }} %).
  </div>
  {% endif %}

  {% if custodian.by_currency %}
  <div class="bars mb-5">
    {% for b in custodian.by_currency %}
    <div class="bar cust-grid" data-tip data-title="Conversions {{ b.currency }}" data-rows='[["Marge prélevée","{{ b.markup_chf|chf(2) }} CHF","var(--s{{ loop.index0 }})"],["Taux effectif","{{ b.markup_pct|round(2) }} %",""],["Volume converti","{{ b.volume_chf|chf(2) }} CHF",""],["Opérations","{{ b.count }}",""]]'>
      <span class="b-name"><i class="dot" style="background:var(--s{{ loop.index0 }})"></i><span>{{ b.currency }}</span></span>
      <span class="b-track"><i style="width:{{ (b.markup_chf / custodian.markup_chf * 100)|round(2) }}%;background:var(--s{{ loop.index0 }})"></i></span>
      <span class="b-amt num">{{ b.markup_chf|chf(2) }} CHF</span>
      <span class="b-pct num">{{ b.markup_pct|round(2) }} %</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if charts.custodian %}
  {% set cc = charts.custodian %}
  <div class="chart-scroll">
    <svg class="chart" viewBox="0 0 {{ cc.width }} {{ cc.height }}" role="img"
         aria-label="Cumul de la marge de change prélevée">
      {% for t in cc.ticks %}
      <line class="gridline" x1="{{ cc.pad_left }}" x2="{{ cc.width - 12 }}" y1="{{ t.y }}" y2="{{ t.y }}"/>
      <text class="tick" x="{{ cc.pad_left - 8 }}" y="{{ t.y + 4 }}" text-anchor="end">{{ t.value|round(0)|int }}</text>
      {% endfor %}
      <polyline points="{{ cc.line }}" fill="none" stroke="var(--s1)" stroke-width="2"
                stroke-linejoin="round" stroke-linecap="round"/>
      {% for d in cc.dots %}
      <circle cx="{{ d.x }}" cy="{{ d.y }}" r="3.2" fill="var(--s1)" stroke="var(--surface)" stroke-width="2" data-tip data-title="{{ d.conv.date.strftime('%d.%m.%Y') }} · {{ d.conv.currency }}" data-rows='[["Montant crédité","{{ d.conv.foreign_amount|chf(2) }} {{ d.conv.currency }}",""],["Valeur au taux affiché","{{ d.conv.reference_chf|chf(2) }} CHF",""],["Réellement débité","{{ d.conv.charged_chf|chf(2) }} CHF",""],["Marge","{{ d.conv.markup_chf|chf(2) }} CHF · {{ d.conv.markup_pct|round(2) }} %",""],["Cumul","{{ d.running|chf(2) }} CHF",""]]' class="clickable"/>
      {% endfor %}
      <text class="dlabel" x="{{ cc.last.x - 6 }}" y="{{ cc.last.y - 12 }}" text-anchor="end">
        {{ cc.total|chf(2) }} CHF au total
      </text>
      <text class="tick" x="{{ cc.pad_left }}" y="{{ cc.baseline + 18 }}">{{ cc.start.strftime('%m.%Y') }}</text>
      <text class="tick" x="{{ cc.width - 12 }}" y="{{ cc.baseline + 18 }}" text-anchor="end">{{ cc.end.strftime('%m.%Y') }}</text>
      <line class="axisline" x1="{{ cc.pad_left }}" x2="{{ cc.width - 12 }}" y1="{{ cc.baseline }}" y2="{{ cc.baseline }}"/>
    </svg>
  </div>
  {% endif %}

  <details class="raw mt-4">
    <summary class="muted clickable f-md">
      Voir les {{ custodian.count }} conversions en détail
    </summary>
    <div class="tbl-wrap mt-3 tbl-scroll">
      <table class="data sortable-table">
        <thead><tr>
          <th data-type="date">Date</th><th>Devise</th>
          <th class="r" data-type="num">Montant</th>
          <th class="r" data-type="num">Taux affiché</th>
          <th class="r" data-type="num">Valeur au taux affiché</th>
          <th class="r" data-type="num">Débité</th>
          <th class="r" data-type="num">Marge</th>
          <th class="r" data-type="num">%</th>
        </tr></thead>
        <tbody>
          {% for c in custodian.conversions %}
          <tr>
            <td class="num">{{ c.date|fr_date }}</td>
            <td>{{ c.currency }}{% if c.manual %} <span class="chip">manuel</span>{% endif %}</td>
            <td class="r num">{{ c.foreign_amount|chf(2) }}</td>
            <td class="r num">{{ c.printed_rate }}</td>
            <td class="r num">{{ c.reference_chf|chf(2) }}</td>
            <td class="r num">{{ c.charged_chf|chf(2) }}</td>
            <td class="r num">{{ c.markup_chf|chf(2) }}</td>
            <td class="r num">{{ c.markup_pct|round(2) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  </details>
</section>
{% endif %}
