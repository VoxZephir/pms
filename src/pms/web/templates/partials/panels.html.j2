      <div class="bar geo-grid" data-tip data-title="{{ d.day }}" data-rows='[["Dépensé","{{ d.amount|chf(2) }} CHF",""],["Transactions","{{ d.count }}",""]{% if d.count %},["Moyenne","{{ (d.amount / d.count)|chf(2) }} CHF",""]{% endif %}]'>
        <span class="b-name"><span>{{ d.day }}</span></span>
        <span class="b-track"><i style="width:{{ d.pct|round(2) }}%;background:var(--s0)"></i></span>
        <span class="b-amt num">{{ d.amount|chf(0) }} CHF</span>
        <span class="b-pct num">{{ d.count }}×</span>
      </div>
      {% endfor %}
    </div>
    {# Twin of the hover-only bars: the same seven days, the same figures. #}
    <details class="raw raw-table mt-4">
      <summary class="muted clickable f-md">Voir le détail en table</summary>
