{# What changed this month (review.py). Only on a one-month window: elsewhere
   "this month" has no meaning. An empty list says so in words -- "nothing
   unusual" is an answer, and a blank would read as a panel that failed. #}
{% if review %}
{% set win = {'from': review.first.isoformat(), 'to': review.last.isoformat()} %}
<section class="block card pad" id="p-review">
  <div class="chart-head">
    <h3>Revue du mois — {{ review.label }}</h3>
    <div class="hint">{% if review.partial %}mois en cours, au {{ review.last|fr_date }} · {% endif %}comparé aux {{ review.history_months }} mois entiers qui précèdent</div>
  </div>

  <p class="review-lead">
    <b class="num">{{ review.spent|chf(0) }} CHF</b> dépensés{% if review.partial %} à ce jour{% endif %},
    pour une médiane de <span class="num">{{ review.median|chf(0) }} CHF</span> par mois entier
    {%- if review.delta_pct is not none and not review.partial %}
    ({{ '+' if review.delta_pct >= 0 else '' }}{{ review.delta_pct|round(0)|int }} %)
    {%- endif %}.
  </p>

  <div class="review-grid">
    <div class="review-list">
      <h4>Prix qui ont changé</h4>
      {% if review.prices %}
      <ul>
        {% for p in review.prices %}
        <li>
          <a href="{{ url_for('dashboard.transactions', q=p.label, **win) }}">{{ p.label }}</a>
          <span class="num">{{ p.before|chf(2) }} → {{ p.now|chf(2) }} {{ p.currency }}
            <span class="chip {{ 'neg' if p.delta > 0 else 'pos' }}">{{ '+' if p.delta > 0 else '' }}{{ '%.1f'|format(p.pct) }} %</span></span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted f-sm">Aucun : les engagements à prix fixe ont gardé leur prix.</p>
      {% endif %}
    </div>

    <div class="review-list">
      <h4>Nouveaux bénéficiaires</h4>
      {% if review.new_payees %}
      <ul>
        {% for p in review.new_payees %}
        <li>
          <a href="{{ url_for('dashboard.transactions', q=p.label, **win) }}">{{ p.label }}</a>
          <span class="num">{{ p.amount|chf(0) }} CHF</span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted f-sm">Aucun virement vers un nouveau bénéficiaire, aucun gros achat chez un nouveau commerçant.</p>
      {% endif %}
    </div>

    <div class="review-list">
      <h4>Débits peut-être doublés</h4>
      {% if review.duplicates %}
      <ul>
        {% for d in review.duplicates %}
        <li>
          <a href="{{ url_for('dashboard.transactions', q=d.label, **win) }}">{{ d.label }}</a>
          <span class="num">2 × {{ d.amount|chf(2) }} CHF · {{ d.dates[0].strftime('%d.%m') }}{% if d.dates[1] != d.dates[0] %} et {{ d.dates[1].strftime('%d.%m') }}{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted f-sm">Aucun montant identique chez le même bénéficiaire à moins de trois jours d'écart.</p>
      {% endif %}
    </div>

    <div class="review-list">
      <h4>Au-dessus de l'habitude</h4>
      {% if review.categories %}
      <ul>
        {% for c in review.categories %}
        <li>
          <a href="{{ url_for('dashboard.transactions', category=c.category, **win) }}">{{ c.category }}</a>
          <span class="num">{{ c.amount|chf(0) }} CHF ·
            {% if c.seasonal %}l’an passé {{ c.habit|chf(0) }} CHF{% elif c.habit < 1 %}d’habitude rien{% else %}d’habitude {{ c.habit|chf(0) }} CHF{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted f-sm">Chaque catégorie est restée dans sa fourchette habituelle.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
