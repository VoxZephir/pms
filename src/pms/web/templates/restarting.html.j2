{% extends "layout.html.j2" %}
{% block title %}Redémarrage · Relevé Swissquote{% endblock %}

{# The no-JavaScript path after a restart. A redirect would point the browser at
   a socket that is about to close, so the wait is a meta refresh instead --
   three seconds is more than the second or so the supervisor needs to bring the
   process back. #}
{% block head %}<meta http-equiv="refresh" content="3;url={{ back }}">{% endblock %}
{% block scripts %}{% endblock %}

{% block body %}
<main class="wrap" id="main" tabindex="-1">
  <div class="empty-state">
    <h2>Redémarrage du serveur…</h2>
    <p class="muted mt-3">
      {% if added %}{{ added }} nouveau{{ 'x' if added > 1 }} mouvement{{ 's' if added > 1 }} importé{{ 's' if added > 1 }} ·
      {% endif %}{{ movements }} au total.
      Le code chargé est relu au passage.
    </p>
    <p class="mt-5"><a class="btn" href="{{ back }}">Continuer</a></p>
  </div>
</main>
{% endblock %}
