{% extends "layout.html.j2" %}
{% block title %}Transactions{% if pages > 1 %} — page {{ page }} sur {{ pages }}{% endif %} · {{ period.title }} · Relevé Swissquote{% endblock %}

{% block body %}
<main class="wrap pt-5" id="main" tabindex="-1">
  <div class="title-row">
    <h1>Transactions</h1>
    <span class="sub">{{ period.title }} · {{ period.start|fr_date }} → {{ period.end|fr_date }}</span>
  </div>
  {# The id matters: app.js swaps #txPanel in place for sorting, filtering and
     paging. Without it the click is cancelled and nothing happens. #}
  <div class="card pad" id="txPanel">
    {% include "partials/transactions.html.j2" %}
  </div>
</main>
{% endblock %}
