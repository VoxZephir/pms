{% extends "layout.html.j2" %}
{% block title %}Trier les Twint · Relevé Swissquote{% endblock %}

{% block body %}
{# One Twint at a time. Every choice is a plain form button, so the page
   works without JavaScript; app.js maps the digits onto the buttons that
   carry data-key, S onto "Passer" and Z onto "Annuler". #}
<main class="wrap pt-5 narrow-page" id="main" tabindex="-1" data-triage>
  <div class="title-row">
    <h1>Trier les Twint</h1>
    <span class="sub">
      {{ queue_size }} à identifier · {{ done }} déjà classé{{ 's' if done > 1 }}
    </span>
  </div>

  <div class="callout mb-5">
    Le relevé n'imprime que « Paiement Twint » : ni bénéficiaire, ni message.
    Ces lignes ne peuvent donc pas être classées par une règle — seulement par
    toi. Chaque choix pose une épingle sur le mouvement
    (<a href="{{ url_for('dashboard.rules') }}">Reclassements</a>) et passe au
    suivant.
  </div>

  {% if last %}
  <form class="callout mb-4 flex-row gap-2" method="post"
        action="{{ url_for('dashboard.twint_triage') }}" data-triage-undo>
    <input type="hidden" name="key" value="{{ last_key }}">
    <input type="hidden" name="action" value="undo">
    <input type="hidden" name="at" value="{{ at }}">
    <span>{{ last.date|fr_date }} · {{ (-last.amount)|chf(2) }} CHF → <b>{{ last.category }}</b></span>
    <button class="btn" type="submit" data-undo>Annuler <kbd>Z</kbd></button>
  </form>
  {% endif %}

  {% if current %}
  <section class="card pad mb-5" aria-labelledby="triage-current">
    <div class="chart-head mb-2">
      <h2 class="f-lg" id="triage-current">
        {{ (-current.amount)|chf(2) }} CHF · {{ current.date|fr_date }}
        <span class="muted">({{ ['lundi','mardi','mercredi','jeudi','vendredi','samedi','dimanche'][current.date.weekday()] }})</span>
      </h2>
      <div class="hint">{{ at + 1 }} / {{ queue_size }}</div>
    </div>

    {% if hint %}
    <p class="mb-3">Déjà classé à ce montant :
      {% for category, n in hint %}<b>{{ category }}</b> ×{{ n }}{{ ', ' if not loop.last }}{% endfor %}.
    </p>
    {% endif %}

    {% if same_day %}
    <details class="mb-3">
      <summary>Ce jour-là : {{ same_day|length }} autre{{ 's' if same_day|length > 1 }} mouvement{{ 's' if same_day|length > 1 }}</summary>
      <ul class="plain-list mt-2">
        {% for t in same_day %}
        <li>{{ t.label }}{% if t.location %} · <span class="muted">{{ t.location }}</span>{% endif %}
          · {{ t.amount|chf(2) }} {{ t.currency }}</li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    <form method="post" action="{{ url_for('dashboard.twint_triage') }}">
      <input type="hidden" name="key" value="{{ current_key }}">
      <input type="hidden" name="at" value="{{ at }}">
      <div class="triage-targets">
        {% for category in targets %}
        <button class="btn{{ ' suggested' if hint and hint[0][0] == category }}" type="submit"
                name="category" value="{{ category }}"
                {% if loop.index <= keys %}data-key="{{ loop.index }}"{% endif %}>
          {% if loop.index <= keys %}<kbd>{{ loop.index }}</kbd> {% endif %}{{ category }}
        </button>
        {% endfor %}
      </div>
    </form>
    <p class="mt-3">
      <a href="{{ url_for('dashboard.twint_triage', at=at + 1, last=last_key or None) }}" data-skip
         {% if at + 1 >= queue_size %}hidden{% endif %}>Passer <kbd>S</kbd></a>
    </p>
  </section>
  {% else %}
  <div class="card pad mb-5">
    <b>Plus aucun Twint à identifier.</b> Les suivants arriveront avec le
    prochain relevé.
  </div>
  {% endif %}

  {% if groups %}
  {# The one grouping the statement allows: the exact amount. A 2.50 that
     recurs forty times is one decision, not forty -- but the owner's, so
     the form shows what was decided before at that amount and preselects
     only that. It posts to the triage, not to the generic bulk endpoint: that
     one replaces whole pins, and would wipe the Need/Want already decided. #}
  <section class="card pad" aria-labelledby="triage-groups">
    <div class="chart-head mb-2">
      <h3 id="triage-groups">Par montant</h3>
      <div class="hint">{{ groups|length }} montant{{ 's' if groups|length > 1 }} récurrent{{ 's' if groups|length > 1 }}</div>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead><tr><th scope="col">Montant</th><th scope="col">Twint</th>
          <th scope="col">Période</th><th scope="col">Déjà classé à ce montant</th>
          <th scope="col">Classer tous</th></tr></thead>
        <tbody>
          {% for g in groups %}
          <tr>
            <td class="num">{{ g.amount|chf(2) }}</td>
            <td class="num">{{ g.count }}</td>
            <td>{{ g.first|fr_date }} → {{ g.last|fr_date }}</td>
            <td>{% for category, n in g.past %}{{ category }} ×{{ n }}{{ ', ' if not loop.last }}{% else %}<span class="muted">—</span>{% endfor %}</td>
            <td>
              <form class="flex-row gap-2" method="post" action="{{ url_for('dashboard.twint_triage') }}">
                {% for key in g['keys'] %}<input type="hidden" name="keys" value="{{ key }}">{% endfor %}
                <input type="hidden" name="action" value="group">
                <input type="hidden" name="at" value="{{ at }}">
                <label class="sr-only" for="group-{{ loop.index }}">Catégorie pour les {{ g.count }} Twint de {{ g.amount|chf(2) }} CHF</label>
                <select id="group-{{ loop.index }}" name="category" required>
                  <option value="">—</option>
                  {% for category in targets %}
                  <option value="{{ category }}" {{ 'selected' if category == g.suggested }}>{{ category }}</option>
                  {% endfor %}
                </select>
                <button class="btn" type="submit">Classer les {{ g.count }}</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}
</main>
{% endblock %}
